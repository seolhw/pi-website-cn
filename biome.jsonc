{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.astro",
      "src/**/*.ts",
      "src/**/*.js",
      "src/**/*.css",
      "src/**/*.json",
      "!src/content/**",
      "!src/pi/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      // Existing cascade overrides and reduced-motion/player overrides intentionally rely on these CSS patterns.
      "includes": ["src/**/*.css", "src/components/InstallSwitcher.astro"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ],
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
