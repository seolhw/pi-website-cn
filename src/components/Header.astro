---
import ThemeSelect from './ThemeSelect.astro';

const navLinks = [
  { label: '文档', href: '/overview/' },
  { label: '更新日志', href: 'https://pi.dev/changelog' },
  { label: '模型', href: 'https://pi.dev/models' },
  { label: '包', href: 'https://pi.dev/packages' },
  { label: 'Radius', href: 'https://radius.earendil.com/' },
];
---

<header class="site-header">
  <aside class="site-announcement" aria-label="公告">
    Pi 1.0 与 Pi Durable 已发布 <a href="https://earendil.com/posts/pi-1-0/">了解详情 <span aria-hidden="true">→</span></a>
  </aside>
  <nav class="sticky-nav" id="stickyNav" data-nav-open="false">
    <div class="sticky-nav-inner">
      <a class="sticky-nav-logo" href="/" aria-label="Pi 首页">
        <img src="/pi-mark.svg" alt="" width="44" height="44" />
      </a>
      <div class="sticky-nav-page-links" aria-label="主导航">
        {navLinks.map(({ label, href }) => <a href={href} class="sticky-nav-page-link">{label}</a>)}
      </div>
      <div class="header-actions">
        <ThemeSelect />
        <a class="sticky-nav-earendil" href="https://earendil.com" title="Earendil Inc. 网站" aria-label="Earendil Inc. 网站" target="_blank" rel="noopener">
          <svg viewBox="121.24 22.62 81.65 149.38" aria-hidden="true" focusable="false"><path fill="currentColor" d="M202.89 123.89c.4 29.74-40.27 26.97-40.8 48.11h-.05c-.52-21.14-41.19-18.38-40.8-48.11 27.99 0 40.09-46.29 40.82-101.27.74 54.98 12.83 101.27 40.82 101.27h0Z"></path></svg>
        </a>
        <button class="sticky-nav-toggle burger-trigger" type="button" aria-label="打开菜单" aria-controls="navSheet" aria-expanded="false" data-nav-toggle data-open="false">
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <span aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </div>
    <button class="nav-sheet-backdrop" type="button" aria-label="关闭菜单" data-nav-backdrop tabindex="-1"></button>
    <aside class="nav-sheet" id="navSheet" aria-hidden="true" inert data-open="false">
      <div class="nav-sheet-inner">
        <nav class="nav-sheet-links" aria-label="移动端主导航">
          {navLinks.map(({ label, href }) => <a class="nav-sheet-link" href={href}><span>{label}</span><span aria-hidden="true">→</span></a>)}
        </nav>
        <div class="nav-sheet-meta">
          <div class="nav-sheet-theme-select"><ThemeSelect /></div>
          <a href="https://github.com/earendil-works/pi" class="nav-sheet-link" target="_blank" rel="noopener"><span>GitHub</span><span aria-hidden="true">↗</span></a>
        </div>
        <p class="nav-sheet-note">本站为社区维护的中文文档，非 Pi 官方站点。</p>
      </div>
    </aside>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themePickers = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-picker]'));
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const modeLabels: Record<string, string> = { system: '跟随系统', dark: '深色', light: '浅色' };
  const setPickerOpen = (picker: HTMLElement, open: boolean) => {
    const trigger = picker.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const menu = picker.querySelector<HTMLElement>('[role="menu"]');
    if (trigger) trigger.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  };
  const closeThemePickers = (except?: HTMLElement) => {
    themePickers.forEach((picker) => { if (picker !== except) setPickerOpen(picker, false); });
  };
  const applyTheme = (mode: string, save = false) => {
    const selectedMode = mode === 'dark' || mode === 'light' ? mode : 'system';
    const resolvedTheme = selectedMode === 'system' ? (systemTheme.matches ? 'dark' : 'light') : selectedMode;
    root.dataset.themeMode = selectedMode;
    root.dataset.theme = resolvedTheme;
    themePickers.forEach((picker) => {
      const trigger = picker.querySelector<HTMLButtonElement>('[data-theme-trigger]');
      const label = picker.querySelector<HTMLElement>('[data-theme-current]');
      if (label) label.textContent = modeLabels[selectedMode];
      trigger?.setAttribute('aria-label', `主题模式：${modeLabels[selectedMode]}`);
      picker.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((option) => {
        option.setAttribute('aria-checked', String(option.dataset.themeOption === selectedMode));
      });
    });
    themeColor?.setAttribute('content', resolvedTheme === 'dark' ? '#161d27' : '#ebe7e4');
    if (save) {
      try { localStorage.setItem('pi-theme', selectedMode); } catch {}
    }
  };
  applyTheme(root.dataset.themeMode || 'system');
  themePickers.forEach((picker) => {
    const trigger = picker.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const menu = picker.querySelector<HTMLElement>('[role="menu"]');
    const options = Array.from(picker.querySelectorAll<HTMLButtonElement>('[data-theme-option]'));
    trigger?.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeThemePickers(picker);
      setPickerOpen(picker, open);
    });
    trigger?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        closeThemePickers(picker);
        setPickerOpen(picker, true);
        const selected = options.findIndex((option) => option.getAttribute('aria-checked') === 'true');
        options[selected < 0 ? 0 : selected].focus();
      }
    });
    options.forEach((option) => option.addEventListener('click', () => {
      applyTheme(option.dataset.themeOption || 'system', true);
      setPickerOpen(picker, false);
      trigger?.focus();
    }));
    menu?.addEventListener('keydown', (event) => {
      const current = options.indexOf(document.activeElement as HTMLButtonElement);
      let next: number | undefined;
      if (event.key === 'ArrowDown') next = (current + 1) % options.length;
      else if (event.key === 'ArrowUp') next = (current - 1 + options.length) % options.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = options.length - 1;
      else if (event.key === 'Escape') {
        event.preventDefault();
        setPickerOpen(picker, false);
        trigger?.focus();
      }
      if (next !== undefined) {
        event.preventDefault();
        options[next].focus();
      }
    });
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Element && !event.target.closest('[data-theme-picker]')) closeThemePickers();
  });
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Element && !event.target.closest('[data-theme-picker]')) closeThemePickers();
  });
  systemTheme.addEventListener('change', () => {
    if (root.dataset.themeMode === 'system') applyTheme('system');
  });

  const nav = document.querySelector<HTMLElement>('#stickyNav');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.querySelector<HTMLElement>('#navSheet');
  const backdrop = document.querySelector<HTMLButtonElement>('[data-nav-backdrop]');
  const closeMenu = () => {
    nav?.setAttribute('data-nav-open', 'false');
    sheet?.setAttribute('data-open', 'false');
    sheet?.setAttribute('aria-hidden', 'true');
    sheet?.setAttribute('inert', '');
    toggle?.setAttribute('data-open', 'false');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', '打开菜单');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    nav?.setAttribute('data-nav-open', String(open));
    sheet?.setAttribute('data-open', String(open));
    sheet?.setAttribute('aria-hidden', String(!open));
    if (open) sheet?.removeAttribute('inert');
    else sheet?.setAttribute('inert', '');
    toggle.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  });
  backdrop?.addEventListener('click', closeMenu);
  sheet?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeThemePickers();
      closeMenu();
    }
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; }
  .site-announcement {
    position: relative;
    z-index: 1;
    padding: 0.3rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-link) 10%, transparent);
    background: var(--color-panel);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.22rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.55;
    text-align: center;
  }
  .site-announcement a { color: var(--color-link); white-space: nowrap; }
  .site-announcement a:hover { color: var(--color-text); }
  .sticky-nav { --sticky-nav-inline-pad: 2rem; position: relative; z-index: 20; width: 100%; padding: 0.8rem var(--sticky-nav-inline-pad) 0; }
  .sticky-nav-inner {
    --sticky-nav-shell-pad-inline: 0.95rem;
    --sticky-nav-shell-pad-block: 0.7rem;
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 96rem);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto;
    padding: var(--sticky-nav-shell-pad-block) var(--sticky-nav-shell-pad-inline);
    border: 1px solid var(--nav-panel-border);
    border-top-color: var(--nav-panel-highlight);
    background: var(--nav-panel-background);
  }
  .sticky-nav-logo { display: inline-flex; align-items: center; color: var(--color-text); }
  .sticky-nav-logo img { display: block; width: 2.444444rem; height: 2.444444rem; }
  .sticky-nav-page-links {
    position: absolute;
    left: 50%;
    display: flex;
    justify-content: center;
    gap: clamp(0.65rem, 1.5vw, 1.25rem);
    transform: translateX(-50%);
  }
  .sticky-nav-page-link {
    color: var(--color-muted-strong);
    font-family: var(--font-ui-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .sticky-nav-page-link:hover { color: var(--color-text); }
  .header-actions { display: flex; align-items: center; gap: 0.8rem; }

  .sticky-nav-earendil { display: inline-flex; align-items: center; margin-inline-end: calc(2.444444rem * 165.29 / 800); color: var(--color-muted-strong); }
  .sticky-nav-earendil:hover { color: var(--color-text); }
  .sticky-nav-earendil svg { display: block; width: auto; height: 1.5rem; }
  .sticky-nav-toggle,
  .nav-sheet-backdrop,
  .nav-sheet { display: none; }
  .sticky-nav-toggle { width: 2.444444rem; height: 2.444444rem; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: var(--color-muted-strong); cursor: pointer; }
  .burger-trigger { flex-direction: column; gap: 0.25rem; }
  .burger-trigger > span { display: flex; gap: 0.12rem; transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease; }
  .burger-trigger i { width: 0.23rem; height: 0.19rem; border-radius: 1px; background: currentColor; }
  .burger-trigger > span:first-child i:first-child,
  .burger-trigger > span:first-child i:last-child,
  .burger-trigger > span:last-child i:first-child,
  .burger-trigger > span:last-child i:last-child { background: var(--color-link); }
  .burger-trigger[data-open="true"] > span:first-child { transform: translateY(0.4rem) rotate(45deg); }
  .burger-trigger[data-open="true"] > span:nth-child(2) { opacity: 0; }
  .burger-trigger[data-open="true"] > span:last-child { transform: translateY(-0.4rem) rotate(-45deg); }
  .nav-sheet-backdrop,
  .nav-sheet { --nav-sheet-max-height: 36rem; }
  .nav-sheet-backdrop { position: fixed; inset: 0; z-index: 0; border: 0; background: #0d1116a8; opacity: 0; pointer-events: none; transition: opacity 180ms ease; }
  .sticky-nav[data-nav-open="true"] .nav-sheet-backdrop { opacity: 1; pointer-events: auto; }
  .nav-sheet { position: absolute; top: calc(100% - 1px); left: 50%; z-index: 1; width: min(calc(100% - var(--sticky-nav-inline-pad) * 2), 96rem); max-height: 0; overflow: hidden; opacity: 0; pointer-events: none; transform: translate(-50%, -0.45rem); transition: max-height 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1); }
  .nav-sheet[data-open="true"] { max-height: min(var(--nav-sheet-max-height), calc(100dvh - 6rem)); overflow-y: auto; opacity: 1; pointer-events: auto; transform: translate(-50%, 0); }
  .nav-sheet-inner { display: grid; gap: 0.9rem; padding: 0.35rem 0.82rem 0.9rem; border: 1px solid var(--nav-panel-border); background: var(--nav-panel-background); }
  .nav-sheet-links { display: grid; gap: 0.2rem; }
  .nav-sheet-link { display: flex; justify-content: space-between; padding: 0.66rem 0.72rem; border: 1px solid transparent; color: var(--color-text); font: 0.88rem var(--font-ui-mono); text-decoration: none; }
  .nav-sheet-link:hover { border-color: var(--color-border-strong); background: color-mix(in srgb, var(--color-text) 4%, transparent); }
  .nav-sheet-meta { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border); padding-top: 0.65rem; }
  .nav-sheet-note { margin: 0; color: var(--color-muted); font-size: 0.72rem; }
  .nav-sheet-theme-select { padding: 0.55rem 0.72rem; }
  .sticky-nav-toggle:focus-visible, .nav-sheet-link:focus-visible { outline: 1px solid var(--color-link); outline-offset: 0.18rem; }

  @media (max-width: 1023px) {
    .sticky-nav { --sticky-nav-inline-pad: 0.65rem; }
    .sticky-nav-inner { --sticky-nav-shell-pad-inline: 0.68rem; --sticky-nav-shell-pad-block: 0.58rem; column-gap: 0.75rem; }
    .sticky-nav-page-links, .sticky-nav-earendil { display: none; }
    .sticky-nav-toggle { display: inline-flex; }
    .nav-sheet-backdrop, .nav-sheet { display: block; }
  }
  @media (max-width: 767px) {
    .site-announcement { font-size: 1.08rem; line-height: 1.48; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-nav-toggle, .burger-trigger > span, .nav-sheet-backdrop, .nav-sheet { transition-duration: 0.01ms; }
  }
</style>
