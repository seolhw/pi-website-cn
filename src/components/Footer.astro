---
const year = new Date().getFullYear();
const socials = [
	{ label: 'GitHub', href: 'https://github.com/earendil-works/pi' },
	{ label: 'npm', href: 'https://www.npmjs.com/package/@earendil-works/pi-coding-agent' },
	{ label: 'Discord', href: 'https://discord.com/invite/nKXTsAcmbT' },
	{ label: 'X', href: 'https://x.com/pidotdev' },
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-left">
			<div class="footer-primary"><a href="https://earendil.com/">Earendil Inc.</a> &amp; Contributors</div>
			<a class="footer-secondary" href="https://pi.dev/press-kit">媒体资料</a>
			<span class="footer-secondary">MIT License</span>
			<span class="footer-secondary">本站为社区维护的中文文档，非 Pi 官方站点。</span>
		</div>
		<div class="footer-right">
			<nav class="footer-socials" aria-label="社交媒体">
				{socials.map(({ label, href }) => <a href={href} aria-label={label} title={label}>{label}</a>)}
				<a href="https://earendil.com" aria-label="Earendil Inc. 官网" title="Earendil Inc. 官网">Earendil</a>
			</nav>
			<p>© {year} Earendil Inc. · <a href="https://exe.dev">pi.dev 域名由 exe.dev 慷慨提供</a></p>
		</div>
	</div>
</footer>

<style>
	@layer starlight.core {
		.site-footer {
			margin-top: 4rem;
			padding: 2.5rem 0 3rem;
			border-top: 1px solid var(--sl-color-hairline-shade);
			font-size: var(--sl-text-xs);
		}

		.footer-inner {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			gap: 2rem;
		}

		.footer-left,
		.footer-right { display: flex; flex-direction: column; gap: 0.55rem; }
		.footer-primary { color: var(--sl-color-text); font-size: var(--sl-text-sm); }
		.footer-primary a { font-weight: 600; }
		.footer-secondary,
		.footer-right p { color: var(--sl-color-gray-3); }
		.footer-socials { display: flex; flex-wrap: wrap; gap: 1rem; }
		a { color: var(--sl-color-text); text-decoration: none; }
		a:hover { color: var(--sl-color-text-accent); }
		.footer-right p { margin: 0; }

		@media (max-width: 50rem) {
			.footer-inner { flex-direction: column; }
			.footer-socials { gap: 0.75rem; }
		}
	}
</style>
