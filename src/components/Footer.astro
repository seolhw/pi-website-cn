---
const year = new Date().getFullYear();
const linkGroups = [
	{
		label: '官方',
		ariaLabel: 'Pi 官方链接',
		links: [
			{ label: 'GitHub', href: 'https://github.com/earendil-works/pi' },
			{ label: 'X', href: 'https://x.com/pidotdev' },
			{ label: 'Discord', href: 'https://discord.com/invite/nKXTsAcmbT' },
			{ label: 'npm', href: 'https://www.npmjs.com/package/@earendil-works/pi-coding-agent' },
		],
	},
	{
		label: '本站',
		ariaLabel: '本站链接',
		links: [{ label: 'GitHub', href: 'https://github.com/seolhw/pi-website-cn' }],
	},
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-left">
			<div class="footer-primary"><a href="https://earendil.com/">Earendil Inc.</a> &amp; Contributors</div>
			<a class="footer-secondary" href="https://pi.dev/press-kit">媒体资料</a>
			<span class="footer-secondary">MIT License</span>
			<span class="footer-secondary">本站为社区维护的中文文档，非 Pi 官方站点。</span>
		</div>
		<div class="footer-right">
			<div class="footer-link-groups">
				{linkGroups.map(({ label, ariaLabel, links }) => (
					<div class="footer-link-row">
						<span class="footer-link-label">{label}：</span>
						<nav class="footer-socials" aria-label={ariaLabel}>
							{links.map(({ label: linkLabel, href }) => <a href={href}>{linkLabel}</a>)}
						</nav>
					</div>
				))}
			</div>
			<p>© {year} Earendil Inc. · <a href="https://exe.dev">pi.dev 域名由 exe.dev 慷慨提供</a></p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: min(100% - 3rem, 96rem);
		margin: 4rem auto 0;
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--color-border-strong);
		font-size: var(--text-xs);
	}
	.footer-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
	.footer-left, .footer-right { display: flex; flex-direction: column; gap: 0.55rem; }
	.footer-primary { color: var(--color-text); font-size: var(--text-sm); }
	.footer-primary a { font-weight: 600; }
	.footer-secondary, .footer-right p { color: var(--color-muted); }
	.footer-link-groups { display: grid; gap: 0.45rem; }
	.footer-link-row { display: flex; align-items: baseline; gap: 0.65rem; }
	.footer-link-label { min-width: 2.8em; color: var(--color-muted); }
	.footer-socials { display: flex; flex-wrap: wrap; gap: 1rem; }
	.footer-socials a, .site-footer a { color: var(--color-text); text-decoration: none; }
	.site-footer a:hover { color: var(--color-link); }
	.footer-right p { margin: 0; }
	@media (max-width: 50rem) {
		.site-footer { width: calc(100% - 2rem); }
		.footer-inner { flex-direction: column; }
		.footer-socials { gap: 0.75rem; }
	}
</style>
