---
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select>
	<Select
		icon="sun"
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[{ label: Astro.locals.t('themeSelect.light'), selected: true, value: 'light' }]}
		width="6.25em"
	/>
</starlight-theme-select>

{/* 暂时只提供亮色主题，强制写入 light，避免沿用系统或旧的 dark 偏好 */}
<script is:inline>
	localStorage.setItem('starlight-theme', 'light');
	document.documentElement.dataset.theme = 'light';
	StarlightThemeProvider.updatePickers('light');
</script>
