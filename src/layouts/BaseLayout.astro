---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/theme.css';
import '../styles/docs-layout.css';
import '../styles/select-control.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Pi 中文文档', description = 'Pi 的中文文档与使用指南。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-theme-mode="system">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ebe7e4" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let mode = 'system';
				try {
					const saved = localStorage.getItem('pi-theme');
					if (saved === 'light' || saved === 'dark' || saved === 'system') mode = saved;
				} catch {}
				root.dataset.themeMode = mode;
				root.dataset.theme = mode === 'system'
					? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
					: mode;
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-content-layer">
			<Header />
			<slot />
			<Footer />
		</div>
	</body>
</html>
