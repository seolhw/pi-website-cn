---
import BaseLayout from './BaseLayout.astro';
import SidebarNav from '../components/SidebarNav.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description?: string;
  activeSlug: string;
  headings: Heading[];
}

const { title, description = '', activeSlug, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const sourcePath = activeSlug === 'overview' ? 'index.md' : `${activeSlug}.md`;
const sourceUrl = `https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/${sourcePath}`;
---

<BaseLayout title={`${title} · Pi`} description={description}>
  <main class="content-shell docs-page">
    <section class:list={['docs-layout', { 'docs-layout-no-toc': toc.length === 0 }]}>
      <div class="docs-mobile-tools">
        <details class="surface-panel docs-mobile-disclosure">
          <summary>文档导航</summary>
          <div class="docs-mobile-disclosure-body"><SidebarNav activeSlug={activeSlug} /></div>
        </details>
        {toc.length > 0 && (
          <details class="surface-panel docs-mobile-disclosure">
            <summary>本页内容</summary>
            <div class="docs-mobile-disclosure-body">
              <nav class="docs-toc-links" aria-label="本页内容">
                {toc.map((heading) => (
                  <a class:list={['docs-toc-link', { 'docs-toc-link-depth-3': heading.depth === 3 }]} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          </details>
        )}
      </div>

      <aside class="docs-nav-rail">
        <section class="surface-panel content-card docs-side-card docs-nav-card">
          <header class="content-card-header"><h2 class="content-card-title">文档</h2></header>
          <div class="content-card-body"><SidebarNav activeSlug={activeSlug} /></div>
        </section>
      </aside>

      <div class="docs-main-column">
        <section class="surface-panel content-card docs-article-card">
          <div class="content-card-body">
            <header class="docs-article-header">
              <div class="docs-article-title-row">
                <h1 class="docs-page-title">{title}</h1>
                <div class="docs-article-meta">
                  <span>Pi 中文文档</span>
                  <span class="docs-article-meta-separator" aria-hidden="true">·</span>
                  <a class="docs-article-action" href={sourceUrl} target="_blank" rel="noopener noreferrer" aria-label="查看上游文档源码">源码 ↗</a>
                </div>
              </div>
            </header>
            <div class="rich-text docs-prose markdown-content"><slot /></div>
          </div>
        </section>
      </div>

      {toc.length > 0 && (
        <aside class="docs-toc-rail">
          <section class="surface-panel content-card docs-side-card docs-toc-card">
            <header class="content-card-header"><h2 class="content-card-title">本页内容</h2></header>
            <div class="content-card-body">
              <nav class="docs-toc-links" aria-label="本页内容">
                {toc.map((heading) => (
                  <a class:list={['docs-toc-link', { 'docs-toc-link-depth-3': heading.depth === 3 }]} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          </section>
        </aside>
      )}
    </section>
  </main>
</BaseLayout>

<script>
  const prose = document.querySelector('.docs-prose');

  if (prose) {
    for (const [index, pre] of [...prose.querySelectorAll<HTMLPreElement>('pre')].entries()) {
      const code = pre.querySelector('code') ?? pre;
      code.id ||= `markdown-code-${index + 1}`;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'markdown-code-copy';
      button.id = `markdown-copy-${index + 1}`;
      button.setAttribute('aria-label', '复制代码');
      button.title = '复制代码';
      button.innerHTML = `
        <span class="markdown-code-copy-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="8" y="3" width="13" height="15" rx="1" stroke="currentColor" stroke-width="1.7"/><path d="M16 18v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h3" stroke="currentColor" stroke-width="1.7"/></svg></span>
        <span class="markdown-code-check-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="2"/></svg></span>`;

      const wrapper = document.createElement('div');
      wrapper.className = 'markdown-code-block';
      pre.before(wrapper);
      wrapper.append(button, pre);
    }

    for (const heading of [...prose.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]')]) {
      const depth = Number(heading.tagName.slice(1));
      const wrapper = document.createElement('div');
      wrapper.className = `markdown-heading depth-${depth}`;
      heading.tabIndex = -1;
      heading.before(wrapper);
      wrapper.append(heading);

      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', '复制本节链接');
      anchor.title = '复制本节链接';
      anchor.innerHTML = `
        <span class="anchor-link" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M6.25 9.75 9.75 6.25M5.5 11.5l-1 1a2.5 2.5 0 0 1-3.5-3.5l3-3a2.5 2.5 0 0 1 3.5 0m2.5-1.5 1-1a2.5 2.5 0 0 1 3.5 3.5l-3 3a2.5 2.5 0 0 1-3.5 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
        <span class="anchor-check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="m3 8 3.2 3.2L13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="anchor-copied-label">已复制</span>`;
      wrapper.append(anchor);
    }

    prose.addEventListener('click', async (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('.markdown-code-copy');
      const anchor = event.target.closest<HTMLAnchorElement>('.heading-anchor');
      const control = button ?? anchor;
      if (!control) return;

      try {
        const text = button
          ? button.parentElement?.querySelector('pre code')?.textContent ?? ''
          : new URL(anchor.href, window.location.href).href;
        await navigator.clipboard.writeText(text);
        control.classList.add('is-copied');
        control.setAttribute('aria-label', button ? '已复制代码' : '已复制链接');
        window.setTimeout(() => {
          control.classList.remove('is-copied');
          control.setAttribute('aria-label', button ? '复制代码' : '复制本节链接');
        }, 1400);
      } catch {
        control.setAttribute('aria-label', '复制失败');
        window.setTimeout(() => control.setAttribute('aria-label', button ? '复制代码' : '复制本节链接'), 1400);
      }
    });
  }
</script>
