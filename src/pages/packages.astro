---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SelectControl from '../components/SelectControl.astro';
import { loadPackageCatalogPage } from '../lib/packages-catalog';
import '../styles/packages.css';

export const prerender = false;

const nameFilter = Astro.url.searchParams.get('name')?.trim().slice(0, 120) ?? '';
const requestedType = Astro.url.searchParams.get('type') ?? '';
const packageType = ['extension', 'skill', 'theme', 'prompt'].includes(requestedType) ? requestedType : '';
const requestedSort = Astro.url.searchParams.get('sort') ?? '';
const sort = ['downloads', 'recent', 'name'].includes(requestedSort) ? requestedSort : 'downloads';
const page = Math.max(1, Math.min(200, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1));
const catalog = await loadPackageCatalogPage(Astro.url);
const docs = await getCollection('docs');
const guide = docs.find((entry) => entry.id === 'packages');
if (!guide) throw new Error('未找到 Pi 包使用指南');
const { Content: GuideContent } = await render(guide);
const totalPages = Math.ceil(catalog.total / 50);
const pageNumbers = [...new Set([1, page - 1, page, page + 1, totalPages].filter((value) => value >= 1 && value <= totalPages))].sort((a, b) => a - b);
const pageHref = (target: number) => {
  const params = new URLSearchParams();
  if (nameFilter) params.set('name', nameFilter);
  if (packageType) params.set('type', packageType);
  if (sort !== 'downloads') params.set('sort', sort);
  if (target > 1) params.set('page', String(target));
  const query = params.toString();
  return `/packages/${query ? `?${query}` : ''}`;
};
const typeLabels: Record<string, string> = {
  extension: '扩展',
  skill: 'Skill',
  theme: '主题',
  prompt: '提示模板',
  package: '软件包',
};
const localizeAge = (value: string) => value
  .replace(/(\d+)s ago/i, '$1 秒前')
  .replace(/(\d+)m ago/i, '$1 分钟前')
  .replace(/(\d+)h ago/i, '$1 小时前')
  .replace(/(\d+)d ago/i, '$1 天前')
  .replace(/(\d+)w ago/i, '$1 周前')
  .replace(/(\d+)mo ago/i, '$1 个月前')
  .replace(/(\d+)y ago/i, '$1 年前');
const recentPages = catalog.recent;
const packageHref = (path: string) => `${path.replace(/\/+$/, '')}/`;
---

<BaseLayout title="Pi 包目录 · Pi" description="浏览 Pi 社区发布的扩展、Skills、提示模板和主题包。">
  <main class="content-shell packages-dashboard">
    <header class="packages-hero">
      <p class="packages-eyebrow">PI / COMMUNITY CATALOG</p>
      <h1 class="packages-title">Pi 包目录</h1>
      <p class="packages-description">
        浏览发布到 npm 的扩展、Skills、提示模板和主题。使用 <code>pi install npm:&lt;package&gt;</code> 安装。
        <a href="#package-guide">查看软件包指南</a>。
      </p>
    </header>

    {recentPages.length > 0 && (
      <section class="surface-panel content-card packages-recent-card">
        <header class="content-card-header"><h2 class="content-card-title">最近发布</h2></header>
        <div class="content-card-body">
          <div class="packages-recent-grid">
            {recentPages.map((item) => (
              <a href={packageHref(item.path)} class="packages-recent-item">
                <strong>{item.name}</strong>
                <span>{item.description}</span>
                <small>{localizeAge(item.published)}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="surface-panel content-card packages-index-card">
      <header class="content-card-header">
        <h2 class="content-card-title">全部软件包</h2>
        <div class="content-card-actions">
          <span class="packages-count">
            {catalog.total ? `${catalog.first.toLocaleString('en-US')}–${catalog.last.toLocaleString('en-US')} / ${catalog.total.toLocaleString('en-US')}` : '目录暂不可用'}
          </span>
        </div>
      </header>
      <div class="content-card-body">
        <form class="packages-action-bar" action="/packages/" method="get">
          <label class="packages-search-field">
            <span class="visually-hidden">按名称、说明或作者筛选</span>
            <input class="packages-input" type="search" name="name" placeholder="筛选软件包…" autocomplete="off" value={nameFilter} />
          </label>
          <div>
            <SelectControl
              label="按软件包类型筛选"
              name="type"
              value={packageType}
              className="packages-select"
              options={[
                { value: '', label: '所有类型' },
                { value: 'extension', label: '扩展' },
                { value: 'skill', label: 'Skill' },
                { value: 'theme', label: '主题' },
                { value: 'prompt', label: '提示模板' },
              ]}
            />
          </div>
          <div>
            <SelectControl
              label="排序方式"
              name="sort"
              value={sort}
              className="packages-select"
              options={[
                { value: 'downloads', label: '下载量最高' },
                { value: 'recent', label: '最近发布' },
                { value: 'name', label: '名称 A–Z' },
              ]}
            />
          </div>
          <div class="packages-form-actions">
            <button class="packages-button packages-button-primary" type="submit">搜索</button>
            <a class="packages-button" href="/packages/">重置</a>
          </div>
        </form>

        {catalog.error && <p class="packages-empty">暂时无法连接 Pi 包目录，请稍后刷新重试。</p>}
        {!catalog.error && catalog.packages.length === 0 && <p class="packages-empty">没有找到符合条件的软件包。</p>}

        <div class="packages-grid">
          {catalog.packages.map((item) => (
            <article class="surface-panel content-card packages-card">
              <div class:list={['packages-card-preview', `packages-card-preview-${item.previewType}`]} aria-hidden="true">
                <div class="packages-preview-frame"><span>PI / {typeLabels[item.previewType] ?? 'PACKAGE'}</span><i></i><i></i><i></i></div>
                {item.previewUrl && <img class="packages-preview-image" src={item.previewUrl} alt="" loading="lazy" decoding="async" />}
              </div>
              <div class="packages-card-body">
                <h3 class="packages-name"><a href={packageHref(item.path)}>{item.name}</a></h3>
                <p class="packages-desc">{item.description}</p>
                <div class="packages-meta">
                  {item.author && <span>{item.author}</span>}
                  {item.downloads && <span>{item.downloads}</span>}
                  {item.published && <span>{localizeAge(item.published)}</span>}
                </div>
                {item.types.length > 0 && (
                  <div class="packages-badges">
                    {item.types.map((type) => <span class="packages-badge">{typeLabels[type] ?? type}</span>)}
                  </div>
                )}
                <nav class="packages-links" aria-label={`${item.name} 的外部链接`}>
                  {item.npmUrl && <a href={item.npmUrl} target="_blank" rel="noopener noreferrer"><span class="npm-mark" aria-hidden="true">npm</span> npm</a>}
                  {item.repositoryUrl && <a href={item.repositoryUrl} target="_blank" rel="noopener noreferrer"><span class="github-mark" aria-hidden="true">◉</span> 仓库</a>}
                  {item.reportUrl && <a href={item.reportUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⚑</span> 举报</a>}
                </nav>
                <div class="packages-install">
                  <code>{item.installCommand}</code>
                  <button class="packages-copy-button" type="button" data-copy-install={item.installCommand}>复制</button>
                </div>
              </div>
            </article>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="packages-pagination" aria-label="软件包分页">
            {page > 1
              ? <a class="packages-page-link" href={pageHref(page - 1)}>← 上一页</a>
              : <span class="packages-page-link is-disabled">← 上一页</span>}
            <div class="packages-pagination-pages">
              {pageNumbers.map((number, index) => (
                <>
                  {index > 0 && number - pageNumbers[index - 1] > 1 && <span class="packages-page-ellipsis" aria-hidden="true">…</span>}
                  {number === page
                    ? <span class="packages-page-number is-active" aria-current="page">{number}</span>
                    : <a class="packages-page-number" href={pageHref(number)}>{number}</a>}
                </>
              ))}
            </div>
            {page < totalPages
              ? <a class="packages-page-link" href={pageHref(page + 1)}>下一页 →</a>
              : <span class="packages-page-link is-disabled">下一页 →</span>}
          </nav>
        )}
      </div>
    </section>

    <section class="surface-panel content-card packages-guide-card" id="package-guide">
      <header class="content-card-header"><h2 class="content-card-title">Pi 包使用指南</h2></header>
      <div class="content-card-body">
        <div class="rich-text docs-prose markdown-content packages-guide-content"><GuideContent /></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.packages-preview-image').forEach((image) => {
    image.addEventListener('error', () => image.remove(), { once: true });
  });

  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-copy-install]');
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copyInstall ?? '');
      button.textContent = '已复制';
      window.setTimeout(() => { button.textContent = '复制'; }, 1400);
    } catch {
      button.textContent = '复制失败';
      window.setTimeout(() => { button.textContent = '复制'; }, 1400);
    }
  });
</script>
