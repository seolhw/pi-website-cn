---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

export const prerender = true;

const [entry] = await getCollection('changelog');
if (!entry) throw new Error('未找到 Pi 更新日志源文件');
const { Content, headings } = await render(entry);
const releaseHeadings = headings.filter((heading) => heading.depth === 2);
---

<DocsLayout
  title="更新日志"
  description="Pi Coding Agent 各版本更新内容。"
  activeSlug="changelog"
  headings={releaseHeadings}
>
  <div class="changelog-content" data-changelog>
    <Content />
  </div>
</DocsLayout>

<script>
  const changelog = document.querySelector<HTMLElement>('[data-changelog]');
  changelog?.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
    const href = link.getAttribute('href') ?? '';
    const match = href.match(/^docs\/(.+?)\.md(#[\s\S]*)?$/);
    if (!match) return;
    const page = match[1] === 'index' ? 'overview' : match[1];
    link.setAttribute('href', `/${page}/${match[2] ?? ''}`);
  });
</script>

<style is:global>
  .changelog-content > h1:first-child { display: none; }
</style>
