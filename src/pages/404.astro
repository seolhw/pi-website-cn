---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="页面未找到 · Pi" description="抱歉，找不到你访问的页面。">
	<main class="not-found">
		<p class="eyebrow">404 / 未找到</p>
		<h1>这条路径没有通向 Pi。</h1>
		<p>页面可能已移动、重命名，或链接本身有误。</p>
		<a href="/">返回首页 <span aria-hidden="true">→</span></a>
		<a href="/quickstart/">阅读快速开始</a>
	</main>
</BaseLayout>

<style>
	.not-found { width: min(48rem, calc(100% - 2rem)); margin: 6rem auto 8rem; padding: 3rem; border: 1px solid var(--color-border); background: var(--color-panel); }
	.eyebrow { color: var(--color-link); font: 0.75rem var(--font-ui-mono); letter-spacing: 0.12em; text-transform: uppercase; }
	h1 { margin: 1rem 0; font-size: clamp(2rem, 6vw, 3.5rem); font-style: italic; font-weight: 400; }
	.not-found > a { display: inline-block; margin: 1rem 1rem 0 0; color: var(--color-link); }
</style>
